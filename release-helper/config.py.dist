GITLAB_URL = "https://git.sandis.io"

# "flows" ogranicza dostępne przepływy do tych, które projekt realnie wspiera.
# Pominięcie klucza = wszystkie przepływy z FLOWS.
PROJECTS = {
    "jaguarapp-front": {
        "path": "/home/YOUR_USER/projekty/jaguarapp-front",
        "namespace": "sandis/jaguarapp-front",
        "flows": ["sit-to-test", "test-to-master"],
    },
    "claims-front": {
        "path": "/home/YOUR_USER/projekty/claims-front",
        "namespace": "sandis/claims-front",
        # sit → test → stage → master; stage → master robisz ręcznie w GitLabie
        "flows": ["sit-to-test", "test-to-stage"],
    },
    "d2c-front": {
        "path": "/home/YOUR_USER/projekty/d2c-front",
        "namespace": "sandis/d2c-front",
        "flows": ["sit-to-test", "test-to-master"],
    },
    "pelicanapp": {
        "path": "/home/YOUR_USER/projekty/pelicanapp",
        "namespace": "sandis/pelicanapp",
        # Statyczny CHANGELOG.md bumpowany na branchu feature — skrypt go tylko
        # czyta, nie tworzy brancha release ani MR-ów back-merge.
        "changelog": "static",
        "flows": ["sit-to-test", "test-to-master"],
    },
}
